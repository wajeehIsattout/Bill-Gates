# Admin password (required). Change it and restart the server.
ADMIN_PASSWORD=helloworld!!

# Port and interface to listen on (0.0.0.0 = reachable from other devices on the network)
PORT=4070
HOST=0.0.0.0

# Where the SQLite database is stored (relative to the project folder or absolute)
DATA_DIR=data

# Cookie "Secure" flag: auto (only when the request is HTTPS), true, or false
COOKIE_SECURE=auto
# Set to true only if you run behind a reverse proxy (nginx/caddy) that sets X-Forwarded-For
TRUST_PROXY=false
# How long an admin login lasts, in hours
SESSION_HOURS=168
